# ==============================================================================
# NextLaunch Pro - Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode Switcher
# Set to "true" to enable instant 1-click preview without database setup
# Set to "false" for production database & user authentication
NEXT_PUBLIC_DEMO_MODE="false"

# Database Connection (PostgreSQL, Supabase, Neon, or SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextlaunch_db?schema=public"

# Payment Gateway Switcher ('stripe' | 'polar' | 'midtrans')
NEXT_PUBLIC_PAYMENT_PROVIDER="polar"

# Polar Merchant of Record & Subscriptions Integration (Zero-Tax MoR)
# Get your keys at https://polar.sh/settings
POLAR_ACCESS_TOKEN="polar_at_xxxxxxxxxxxxxxxxxxxxxxxx"
POLAR_ORGANIZATION_ID="org_xxxxxxxxxxxxxxxxxxxxxxxx"
POLAR_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
POLAR_ENVIRONMENT="sandbox" # Set to "production" for live billing
NEXT_PUBLIC_POLAR_PRO_PRODUCT_ID="prod_pro_xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POLAR_ENTERPRISE_PRODUCT_ID="prod_ent_xxxxxxxxxxxxxxxx"

# Stripe Configuration (Standard Subscriptions & Checkout)
# Get your keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_51xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="price_1xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID="price_1xxxxxxxxxxxxxxxx"

# Supabase Auth (Optional - for OAuth Google/GitHub & Magic Links)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# AI Copilot Studio (Gemini 2.5 Flash / Interactions API)
GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxx"

# Transactional Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="NextLaunch <onboarding@yourdomain.com>"
