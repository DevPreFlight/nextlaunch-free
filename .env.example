# ==============================================================================
# NextLaunch Community Starter (Free / MIT Edition) - Environment Variables
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL / Supabase / Neon / Local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextlaunch_free?schema=public"

# Supabase Auth Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
